# Copy to env.yaml and fill in. env.yaml is gitignored — never commit it.
# Deploy with:  gcloud run deploy --env-vars-file env.yaml

TELEGRAM_TOKEN: "7123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SPREADSHEET_ID: "1zLO85tPtJkAyPclcWYlTCSlznz-oFtzOqUvhwFMtUTg"

# Filled in after the first deploy, once Cloud Run has given you a URL.
WEBHOOK_URL: "https://bollette-bot-xxxxxxxx.europe-west1.run.app"

# GOOGLE_CREDENTIALS_JSON is deliberately absent.
#
# On Cloud Run the service runs as the picotti-bot service account, so it
# authenticates by identity and needs no key file. Deploy with:
#
#   gcloud run deploy --service-account picotti-bot@PROJECT_ID.iam.gserviceaccount.com
#
# Only set GOOGLE_CREDENTIALS_JSON when running the bot outside this Google
# project — locally, or on another host — where that identity isn't available.
